# Supabase project: Settings → API
NUXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe in the browser; RLS does the enforcing.
NUXT_PUBLIC_SUPABASE_KEY=
# Secret (service role) key. Server only, never expose to the client.
NUXT_SUPABASE_SECRET_KEY=
# Stripe (Developers → API keys). Use test keys (pk_test_ / sk_test_) until launch.
NUXT_PUBLIC_STRIPE_KEY=
NUXT_STRIPE_SECRET_KEY=
# Signing secret of the connected-accounts webhook endpoint (whsec_...).
NUXT_STRIPE_WEBHOOK_SECRET=
# Booking payments: events on lokl's own Stripe account (a separate endpoint,
# /api/stripe/webhook-payments). Locally, `stripe listen` prints one.
NUXT_STRIPE_PAYMENTS_WEBHOOK_SECRET=
# Shared secret for the timed booking jobs (/api/jobs/*), sent by
# `npm run job -- <name>` and, after launch, by the scheduler. Any long random
# string, e.g. `openssl rand -hex 32`. Different in every environment.
NUXT_JOB_SECRET=
# Booking emails, sent through Resend. Use their own key ("Sending access",
# limited to innatetheory.com), not the key Supabase uses for sign-in emails.
NUXT_RESEND_API_KEY=
# off (nothing sent), allowlist (only the addresses below: development), or
# send (everyone: production).
NUXT_EMAIL_MODE=off
# For allowlist mode: comma-separated addresses that may receive emails.
NUXT_EMAIL_ALLOWLIST=
# Where replies go (lokl@innatetheory.com has no inbox). Nothing is sent
# until this is set.
NUXT_EMAIL_REPLY_TO=
# The admin app's address: the only origin allowed to call /api/admin/*.
NUXT_ADMIN_ORIGIN=http://localhost:3101
# Where people can write to lokl, shown on pages (e.g. a paused provider's
# dashboard). The same as NUXT_EMAIL_REPLY_TO for now.
NUXT_PUBLIC_SUPPORT_EMAIL=
# Base URL Stripe sends providers back to after onboarding.
NUXT_PUBLIC_SITE_URL=http://localhost:3100
