# Supabase project: Settings → API
NUXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe in the browser; RLS does the enforcing.
NUXT_PUBLIC_SUPABASE_KEY=
# Secret (service role) key. Server only, never expose to the client.
NUXT_SUPABASE_SECRET_KEY=
# Stripe (Developers → API keys). Use test keys (pk_test_ / sk_test_) until launch.
NUXT_PUBLIC_STRIPE_KEY=
NUXT_STRIPE_SECRET_KEY=
# Signing secret of the connected-accounts webhook endpoint (whsec_...).
NUXT_STRIPE_WEBHOOK_SECRET=
# Booking payments: events on lokl's own Stripe account (a separate endpoint,
# /api/stripe/webhook-payments). Locally, `stripe listen` prints one.
NUXT_STRIPE_PAYMENTS_WEBHOOK_SECRET=
# Base URL Stripe sends providers back to after onboarding.
NUXT_PUBLIC_SITE_URL=http://localhost:3100
