# Supabase project: Settings → API
NUXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe in the browser; RLS does the enforcing.
NUXT_PUBLIC_SUPABASE_KEY=
# Secret (service role) key. Server only, never expose to the client.
NUXT_SUPABASE_SECRET_KEY=
# The website, whose /api/admin/* routes do anything that needs Stripe.
NUXT_PUBLIC_WEBSITE_URL=http://localhost:3100
