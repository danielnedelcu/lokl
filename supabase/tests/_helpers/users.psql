-- Shared setup for access-rule tests. Included at the top of a test file with
--   \ir _helpers/users.psql
-- It runs inside that file's transaction, so everything it creates (the
-- tests schema, its functions, and any users) rolls back with the test.

create extension if not exists pgtap with schema extensions;

create schema tests;
grant usage on schema tests to anon, authenticated, service_role;

-- A bare auth.users row. Enough for foreign keys and auth.uid(); no password.
create function tests.create_user(p_email text) returns uuid
language sql as $$
  insert into auth.users (id, email) values (gen_random_uuid(), p_email) returning id;
$$;

-- Act as a signed-in user for the rest of the transaction, the way PostgREST
-- does: switch to the authenticated role and set the JWT claims that
-- auth.uid() and auth.jwt() read. p_app_role fills app_metadata.role.
create function tests.authenticate_as(p_user_id uuid, p_app_role text default null, p_aal text default 'aal1', p_session uuid default null) returns void
language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object(
    'sub', p_user_id,
    'aal', p_aal,
    'session_id', p_session,
    'role', 'authenticated',
    'app_metadata', case when p_app_role is null then '{}'::json
                         else json_build_object('role', p_app_role) end
  )::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;

-- Admin (docs/design/admin-roles.md): an active admin_members row (owner
-- unless said), signed in on a session that passed the second factor
-- (aal2) and is current in auth.sessions. make_admin adds both as the
-- runner (security definer: the tests switch roles) and returns the
-- session; authenticate_as_admin then acts as them, and names that session
-- in the request header the server sends (x-lokl-admin-session), so later
-- calls with the server key act for this admin.
create function tests.make_admin(p_user_id uuid, p_role text default 'owner') returns uuid
language plpgsql security definer set search_path = '' as $$
declare
  v_session uuid;
begin
  insert into public.admin_members (user_id, role, status, joined_at)
  values (p_user_id, p_role, 'active', now())
  on conflict (user_id) do update set role = excluded.role, status = 'active', joined_at = coalesce(public.admin_members.joined_at, now()), removed_at = null;
  select s.id into v_session from auth.sessions s where s.user_id = p_user_id and s.aal = 'aal2' limit 1;
  if v_session is null then
    insert into auth.sessions (id, user_id, aal, created_at, updated_at)
    values (gen_random_uuid(), p_user_id, 'aal2', now(), now()) returning id into v_session;
  end if;
  return v_session;
end;
$$;

create function tests.authenticate_as_admin(p_user_id uuid, p_role text default 'owner') returns void
language plpgsql as $$
declare
  v_session uuid := tests.make_admin(p_user_id, p_role);
begin
  perform set_config('request.headers', json_build_object('x-lokl-admin-session', v_session)::text, true);
  perform tests.authenticate_as(p_user_id, 'admin', 'aal2', v_session);
end;
$$;

-- The same admin, signed in with the emailed code only (aal1): no admin access.
create function tests.authenticate_as_admin_code_only(p_user_id uuid) returns void
language plpgsql as $$
begin
  perform tests.make_admin(p_user_id);
  perform tests.authenticate_as(p_user_id, 'admin', 'aal1', null);
end;
$$;

-- The server (secret key) acting for this admin: their session named in the header.
create function tests.authenticate_as_server_for(p_user_id uuid) returns void
language plpgsql as $$
declare
  v_session uuid := tests.make_admin(p_user_id);
begin
  perform set_config('request.headers', json_build_object('x-lokl-admin-session', v_session)::text, true);
  perform set_config('request.jwt.claims', '{"role":"service_role"}', true);
  perform set_config('role', 'service_role', true);
end;
$$;

-- A signed-out visitor using the publishable (anon) key.
create function tests.authenticate_as_anon() returns void
language plpgsql as $$
begin
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
  perform set_config('role', 'anon', true);
end;
$$;

-- The server using the secret key. RLS doesn't apply to this role.
create function tests.authenticate_as_service_role() returns void
language plpgsql as $$
begin
  perform set_config('request.jwt.claims', '{"role":"service_role"}', true);
  perform set_config('role', 'service_role', true);
end;
$$;

-- Back to the test runner's own (superuser) role, e.g. to inspect rows RLS hides.
create function tests.clear_authentication() returns void
language plpgsql as $$
begin
  perform set_config('request.jwt.claims', '', true);
  perform set_config('role', 'none', true);
end;
$$;

-- What a listing needs before it may go live or into review
-- (listing_readiness, enforced by listings_require_ready): payouts set up
-- on its provider, a photo, and, as its kind needs, an address or a travel
-- area. Adds only what's missing. Fixtures insert listings as drafts, call
-- this, then change the status as the app does. A test about a provider
-- whose payouts lapsed later sets the flags back after.
create function tests.make_ready(p_listing uuid) returns void
language plpgsql
security definer
set search_path = ''
as $$
declare
  l public.listings;
begin
  select * into l from public.listings where id = p_listing;
  update public.providers
     set stripe_account_id = coalesce(stripe_account_id, 'acct_test_' || left(replace(id::text, '-', ''), 12)),
         stripe_charges_enabled = true, stripe_payouts_enabled = true
   where id = l.provider_id;
  if not exists (select 1 from public.listing_photos where listing_id = l.id) then
    insert into public.listing_photos (listing_id, storage_path, position, alt_text)
    values (l.id, l.provider_id || '/' || l.id || '/' || gen_random_uuid() || '.jpg', 0, 'A photo');
  end if;
  if (l.kind = 'experience' or l.location_mode = 'provider_location')
     and not exists (select 1 from public.listing_addresses where listing_id = l.id) then
    insert into public.listing_addresses (listing_id, line1, city, state, postal_code)
    values (l.id, '1 Test Street', 'Atlanta', 'GA', '30312');
  end if;
  if l.kind = 'service' and l.location_mode = 'customer_location'
     and not exists (select 1 from public.listing_service_areas where listing_id = l.id) then
    insert into public.listing_service_areas (listing_id, service_area_id)
    select l.id, a.id from public.service_areas a where a.city_id = l.city_id order by a.created_at limit 1;
  end if;
end;
$$;

-- The tests switch between the API roles and back, so those roles call
-- these helpers. Granted explicitly: since function_execute_grants
-- (2026-10-10), new functions get no PUBLIC EXECUTE.
grant execute on all functions in schema tests to anon, authenticated, service_role;
