          "table": "public.categories",
          "columns": [
            "kind",
            "slug"
          ]
        },
        {
          "name": "categories_id_kind_key",
          "def": "CREATE UNIQUE INDEX categories_id_kind_key ON public.categories USING btree (id, kind)",
          "table": "public.categories",
          "columns": [
            "id",
            "kind"
          ]
        }
      ],
      "constraints": [
        {
          "name": "categories_description_check",
          "type": "CHECK",
          "def": "CHECK ((char_length(description) \u003c= 500))",
          "table": "public.categories",
          "referenced_table": "",
          "columns": [
            "description"
          ]
        },
        {
          "name": "categories_kind_check",
          "type": "CHECK",
          "def": "CHECK ((kind = ANY (ARRAY['service'::text, 'experience'::text])))",
          "table": "public.categories",
          "referenced_table": "",
          "columns": [
            "kind"
          ]
        },
        {
          "name": "categories_name_check",
          "type": "CHECK",
          "def": "CHECK (((char_length(name) \u003e= 2) AND (char_length(name) \u003c= 60)))",
          "table": "public.categories",
          "referenced_table": "",
          "columns": [
            "name"
          ]
        },
        {
          "name": "categories_slug_check",
          "type": "CHECK",
          "def": "CHECK ((slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$'::text))",
          "table": "public.categories",
          "referenced_table": "",
          "columns": [
            "slug"
          ]
        },
        {
          "name": "categories_pkey",
          "type": "PRIMARY KEY",
          "def": "PRIMARY KEY (id)",
          "table": "public.categories",
          "referenced_table": "",
          "columns": [
            "id"
          ]
        },
        {
          "name": "categories_kind_slug_key",
          "type": "UNIQUE",
          "def": "UNIQUE (kind, slug)",
          "table": "public.categories",
          "referenced_table": "",
          "columns": [
            "kind",
            "slug"
          ]
        },
        {
          "name": "categories_id_kind_key",
          "type": "UNIQUE",
          "def": "UNIQUE (id, kind)",
          "table": "public.categories",
          "referenced_table": "",
