{
  "name": "postgres",
  "tables": [
    {
      "name": "public.providers",
      "type": "BASE TABLE",
      "comment": "A business or host that sells Services or Experiences. One per login (owner_id is unique). Never deleted: bookings and payouts will point here, so a provider is suspended instead.",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        {
          "name": "owner_id",
          "type": "uuid",
          "nullable": false,
          "comment": "The login that owns and manages this provider. A user is a provider exactly when they own a row here. The login cannot be deleted while it owns a provider: suspend or anonymize the provider first."
        },
        {
          "name": "display_name",
          "type": "text",
          "nullable": false,
          "comment": "Business or host name shown to customers."
        },
        {
          "name": "status",
          "type": "text",
          "nullable": false,
          "default": "'active'::text",
          "comment": "active or suspended. Only admins change it (service role); a suspended provider cannot use provider routes."
        },
        {
          "name": "stripe_account_id",
          "type": "text",
          "nullable": true,
          "comment": "The provider's Stripe Connect Express account. Created by the server on first payout setup."
        },
        {
          "name": "stripe_details_submitted",
          "type": "boolean",
          "nullable": false,
          "default": "false",
          "comment": "Copied from Stripe: the provider finished the onboarding form. Server-only."
        },
        {
          "name": "stripe_charges_enabled",
          "type": "boolean",
          "nullable": false,
          "default": "false",
          "comment": "Copied from Stripe: payments can be made to this provider. Server-only."
        },
        {
          "name": "stripe_payouts_enabled",
          "type": "boolean",
          "nullable": false,
          "default": "false",
          "comment": "Copied from Stripe: Stripe can pay out to the provider's bank. Server-only."
        },
        {
          "name": "created_at",
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()"
        },
        {
          "name": "updated_at",
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()"
        },
        {
          "name": "city_id",
          "type": "uuid",
          "nullable": false,
          "comment": "The city the provider operates in, picked from active cities. Replaces the old free-text city."
        }
      ],
      "indexes": [
        {
          "name": "providers_pkey",
          "def": "CREATE UNIQUE INDEX providers_pkey ON public.providers USING btree (id)",
          "table": "public.providers",
          "columns": [
            "id"
          ]
        },
        {
          "name": "providers_owner_id_key",
          "def": "CREATE UNIQUE INDEX providers_owner_id_key ON public.providers USING btree (owner_id)",
          "table": "public.providers",
          "columns": [
            "owner_id"
          ]
        },
        {
          "name": "providers_stripe_account_id_key",
          "def": "CREATE UNIQUE INDEX providers_stripe_account_id_key ON public.providers USING btree (stripe_account_id)",
          "table": "public.providers",
          "columns": [
            "stripe_account_id"
          ]
        },
        {
          "name": "providers_city_id_idx",
          "def": "CREATE INDEX providers_city_id_idx ON public.providers USING btree (city_id)",
          "table": "public.providers",
          "columns": [
            "city_id"
          ]
        }
      ],
      "constraints": [
        {
          "name": "providers_display_name_check",
          "type": "CHECK",
          "def": "CHECK (((char_length(display_name) \u003e= 2) AND (char_length(display_name) \u003c= 120)))",
          "table": "public.providers",
          "referenced_table": "",
          "columns": [
            "display_name"
          ]
        },
        {
          "name": "providers_status_check",
          "type": "CHECK",
          "def": "CHECK ((status = ANY (ARRAY['active'::text, 'suspended'::text])))",
          "table": "public.providers",
          "referenced_table": "",
          "columns": [
            "status"
          ]
        },
        {
          "name": "providers_owner_id_fkey",
          "type": "FOREIGN KEY",
          "def": "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE RESTRICT",
          "table": "public.providers",
          "referenced_table": "auth.users",
          "columns": [
            "owner_id"
          ],
          "referenced_columns": [
            "id"
          ]
        },
        {
          "name": "providers_pkey",
          "type": "PRIMARY KEY",
          "def": "PRIMARY KEY (id)",
          "table": "public.providers",
          "referenced_table": "",
          "columns": [
            "id"
          ]
        },
        {
          "name": "providers_owner_id_key",
          "type": "UNIQUE",
          "def": "UNIQUE (owner_id)",
          "table": "public.providers",
          "referenced_table": "",
          "columns": [
            "owner_id"
          ]
        },
        {
          "name": "providers_stripe_account_id_key",
          "type": "UNIQUE",
          "def": "UNIQUE (stripe_account_id)",
          "table": "public.providers",
          "referenced_table": "",
          "columns": [
            "stripe_account_id"
          ]
        },
        {
          "name": "providers_city_id_fkey",
          "type": "FOREIGN KEY",
          "def": "FOREIGN KEY (city_id) REFERENCES cities(id) ON DELETE RESTRICT",
          "table": "public.providers",
          "referenced_table": "public.cities",
          "columns": [
            "city_id"
          ],
          "referenced_columns": [
            "id"
          ]
        }
      ],
      "triggers": [
        {
          "name": "providers_city_active",
          "def": "CREATE TRIGGER providers_city_active BEFORE INSERT OR UPDATE OF city_id ON public.providers FOR EACH ROW EXECUTE FUNCTION providers_check_city_active()"
        },
        {
          "name": "providers_set_updated_at",
          "def": "CREATE TRIGGER providers_set_updated_at BEFORE UPDATE ON public.providers FOR EACH ROW EXECUTE FUNCTION set_updated_at()"
        }
      ]
    },
    {
      "name": "public.cities",
      "type": "BASE TABLE",
      "comment": "The places lokl operates. Admin-managed. Never deleted: providers and listings point here, so a city is deactivated instead.",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        {
          "name": "slug",
          "type": "text",
          "nullable": false,
          "comment": "URL-safe identifier, e.g. atlanta. Unique."
        },
        {
          "name": "name",
          "type": "text",
          "nullable": false
        },
        {
          "name": "state",
          "type": "text",
          "nullable": false,
          "comment": "Two-letter US state code, e.g. GA."
        },
        {
          "name": "timezone",
          "type": "text",
          "nullable": false,
          "comment": "IANA time zone name, e.g. America/New_York. Experience session times are entered and shown in it."
        },
        {
          "name": "active",
          "type": "boolean",
          "nullable": false,
          "default": "true",
          "comment": "Inactive cities are hidden everywhere public and in the provider city picker."
        },
        {
          "name": "sort_order",
          "type": "integer",
          "nullable": false,
          "default": "0",
          "comment": "Display order in lists and pickers, lowest first."
        },
        {
          "name": "created_at",
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()"
        },
        {
          "name": "updated_at",
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()"
        }
      ],
      "indexes": [
        {
          "name": "cities_pkey",
          "def": "CREATE UNIQUE INDEX cities_pkey ON public.cities USING btree (id)",
          "table": "public.cities",
          "columns": [
            "id"
          ]
        },
        {
          "name": "cities_slug_key",
          "def": "CREATE UNIQUE INDEX cities_slug_key ON public.cities USING btree (slug)",
          "table": "public.cities",
          "columns": [
            "slug"
          ]
        }
      ],
      "constraints": [
        {
          "name": "cities_name_check",
          "type": "CHECK",
          "def": "CHECK (((char_length(name) \u003e= 2) AND (char_length(name) \u003c= 80)))",
          "table": "public.cities",
          "referenced_table": "",
          "columns": [
            "name"
          ]
        },
        {
          "name": "cities_slug_check",
          "type": "CHECK",
          "def": "CHECK ((slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$'::text))",
          "table": "public.cities",
          "referenced_table": "",
          "columns": [
            "slug"
          ]
        },
        {
          "name": "cities_state_check",
          "type": "CHECK",
          "def": "CHECK ((state ~ '^[A-Z]{2}$'::text))",
          "table": "public.cities",
          "referenced_table": "",
          "columns": [
            "state"
          ]
        },
        {
          "name": "cities_timezone_check",
          "type": "CHECK",
          "def": "CHECK ((timezone ~ '^[A-Za-z_]+(/[A-Za-z0-9_+-]+)+$'::text))",
          "table": "public.cities",
          "referenced_table": "",
          "columns": [
            "timezone"
          ]
        },
        {
          "name": "cities_pkey",
          "type": "PRIMARY KEY",
          "def": "PRIMARY KEY (id)",
          "table": "public.cities",
          "referenced_table": "",
          "columns": [
            "id"
          ]
        },
        {
          "name": "cities_slug_key",
          "type": "UNIQUE",
          "def": "UNIQUE (slug)",
          "table": "public.cities",
          "referenced_table": "",
          "columns": [
            "slug"
          ]
        }
      ],
      "triggers": [
        {
          "name": "cities_set_updated_at",
          "def": "CREATE TRIGGER cities_set_updated_at BEFORE UPDATE ON public.cities FOR EACH ROW EXECUTE FUNCTION set_updated_at()"
        }
      ]
    },
    {
      "name": "public.service_areas",
      "type": "BASE TABLE",
      "comment": "Neighborhoods or zip codes within a city. Where \"I come to you\" Services travel, and the public location label on listings. Admin-managed. Never deleted: listings will point here, so an area is deactivated instead.",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        {
          "name": "city_id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "kind",
          "type": "text",
          "nullable": false,
          "comment": "neighborhood or zip. A zip area's name is a five-digit zip code."
        },
        {
          "name": "name",
          "type": "text",
          "nullable": false,
          "comment": "Shown to customers, e.g. Old Fourth Ward or 30312. Unique per city and kind."
        },
        {
          "name": "active",
          "type": "boolean",
          "nullable": false,
          "default": "true",
          "comment": "Inactive areas are hidden everywhere public."
        },
        {
          "name": "sort_order",
          "type": "integer",
          "nullable": false,
          "default": "0"
        },
        {
          "name": "created_at",
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()"
        },
        {
          "name": "updated_at",
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()"
        }
      ],
      "indexes": [
        {
          "name": "service_areas_pkey",
          "def": "CREATE UNIQUE INDEX service_areas_pkey ON public.service_areas USING btree (id)",
          "table": "public.service_areas",
          "columns": [
            "id"
          ]
        },
        {
          "name": "service_areas_city_id_kind_name_key",
          "def": "CREATE UNIQUE INDEX service_areas_city_id_kind_name_key ON public.service_areas USING btree (city_id, kind, name)",
          "table": "public.service_areas",
          "columns": [
            "city_id",
            "kind",
            "name"
          ]
        }
      ],
      "constraints": [
        {
          "name": "service_areas_check",
          "type": "CHECK",
          "def": "CHECK (((kind \u003c\u003e 'zip'::text) OR (name ~ '^[0-9]{5}$'::text)))",
          "table": "public.service_areas",
          "referenced_table": "",
          "columns": [
            "kind",
            "name"
          ]
        },
        {
          "name": "service_areas_kind_check",
          "type": "CHECK",
          "def": "CHECK ((kind = ANY (ARRAY['neighborhood'::text, 'zip'::text])))",
          "table": "public.service_areas",
          "referenced_table": "",
          "columns": [
            "kind"
          ]
        },
        {
          "name": "service_areas_name_check",
          "type": "CHECK",
          "def": "CHECK (((char_length(name) \u003e= 1) AND (char_length(name) \u003c= 80)))",
          "table": "public.service_areas",
          "referenced_table": "",
          "columns": [
            "name"
          ]
        },
        {
          "name": "service_areas_city_id_fkey",
          "type": "FOREIGN KEY",
          "def": "FOREIGN KEY (city_id) REFERENCES cities(id) ON DELETE RESTRICT",
          "table": "public.service_areas",
          "referenced_table": "public.cities",
          "columns": [
            "city_id"
          ],
          "referenced_columns": [
            "id"
          ]
        },
        {
          "name": "service_areas_pkey",
          "type": "PRIMARY KEY",
          "def": "PRIMARY KEY (id)",
          "table": "public.service_areas",
          "referenced_table": "",
          "columns": [
            "id"
          ]
        },
        {
          "name": "service_areas_city_id_kind_name_key",
          "type": "UNIQUE",
          "def": "UNIQUE (city_id, kind, name)",
          "table": "public.service_areas",
          "referenced_table": "",
          "columns": [
            "city_id",
            "kind",
            "name"
          ]
        }
      ],
      "triggers": [
        {
          "name": "service_areas_set_updated_at",
          "def": "CREATE TRIGGER service_areas_set_updated_at BEFORE UPDATE ON public.service_areas FOR EACH ROW EXECUTE FUNCTION set_updated_at()"
        }
      ]
    },
    {
      "name": "public.categories",
      "type": "BASE TABLE",
      "comment": "Service and Experience categories. Flat and admin-managed; each listing belongs to one category of its own kind. Never deleted: listings will point here, so a category is deactivated instead.",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        {
          "name": "kind",
          "type": "text",
          "nullable": false,
          "comment": "service or experience. A listing can only use a category of its own kind."
        },
        {
          "name": "name",
          "type": "text",
          "nullable": false,
          "comment": "Shown to customers, e.g. Hair and beauty. 2 to 60 characters."
        },
        {
          "name": "slug",
          "type": "text",
          "nullable": false,
          "comment": "URL-safe identifier, unique within its kind, e.g. hair-and-beauty."
        },
        {
          "name": "description",
          "type": "text",
          "nullable": true,
          "comment": "Optional. Shown on the category page later. Up to 500 characters."
        },
        {
          "name": "active",
          "type": "boolean",
          "nullable": false,
          "default": "true",
          "comment": "Inactive categories are hidden everywhere public, and so are their listings."
        },
        {
          "name": "sort_order",
          "type": "integer",
          "nullable": false,
          "default": "0",
          "comment": "Display order within its kind, lowest first."
        },
        {
          "name": "created_at",
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()"
        },
        {
          "name": "updated_at",
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()"
        }
      ],
      "indexes": [
        {
          "name": "categories_pkey",
